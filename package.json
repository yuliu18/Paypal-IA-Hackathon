{
  "name": "ag-paypal-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "seed": "node --experimental-transform-types --env-file=.env.local scripts/seed-sandbox.mts",
    "redteam": "node --experimental-transform-types --env-file-if-exists=.env.local scripts/redteam.mts",
    "db:migrate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/db-migrate.mts",
    "db:probe": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/db-probe.mts",
    "db:copy-sqlite": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/db-copy-sqlite.mts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@neon/auth": "0.8.2",
    "@neon/config": "^1.10.0",
    "@neon/env": "^1.6.8",
    "@paypal/agent-toolkit": "^1.11.0",
    "ag-grid-community": "36.2.0",
    "ag-grid-react": "36.2.0",
    "ag-studio": "3.0.0",
    "ag-studio-react": "3.0.0",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "nodemailer": "10.0.16",
    "pg": "8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.5"
  }
