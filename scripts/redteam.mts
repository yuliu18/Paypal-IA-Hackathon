// Tests the running support agent the way an attacker and a shop would, with promptfoo
// (https://www.promptfoo.dev, MIT) through npx at a pinned version: no dependency of the app.
//   npm run redteam            attacks: promptfoo's red team against /api/support/tickets
//   npm run redteam business   business cases a shop expects to work
//   npm run redteam view       open the results in promptfoo's local viewer
// The app must be running (npm run dev, or REDTEAM_TARGET=https://… with DEMO_PASSWORD) with
// sample payments created. Attacks are written and graded by the AI model chosen on /settings,
// or REDTEAM_MODEL on the same provider. REDTEAM_TESTS sets the attacks per plugin (default 3).
// Sandbox money only; refunds use the sample payments.

import { spawnSync } from 'node:child_process';
import { chmodSync, mkdirSync, writeFileSync } from 'node:fs';
import { dirname, join, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';
import { readSeed } from '../lib/demo-seed.ts';
import { loadSettings } from '../lib/settings/settings.ts';
import { attackConfig, businessConfig, type Fixtures } from './redteam-config.ts';

const PROMPTFOO = 'promptfoo@0.124.1';
const root = resolve(dirname(fileURLToPath(import.meta.url)), '..');
const out = join(root, 'redteam', '.generated');

const mode = process.argv[2] ?? 'attacks';
const env: NodeJS.ProcessEnv = {
  ...process.env,
  PROMPTFOO_DISABLE_TELEMETRY: '1',
  PROMPTFOO_DISABLE_UPDATE: '1',
  // Attacks are generated by the configured model and not sent to promptfoo's servers, unless
  // REDTEAM_REMOTE=1 adds the plugins that need them (bola, bfla, hijacking, excessive-agency).
  ...(process.env.REDTEAM_REMOTE === '1' ? {} : { PROMPTFOO_DISABLE_REMOTE_GENERATION: 'true' }),
  PROMPTFOO_DISABLE_SHARING: '1',
};
const promptfoo = (...args: string[]) => spawnSync('npx', ['-y', PROMPTFOO, ...args], { stdio: 'inherit', env, cwd: root }).status ?? 1;

if (mode === 'view') process.exit(promptfoo('view', '--yes'));
if (mode !== 'attacks' && mode !== 'business') {
  console.error('Usage: npm run redteam [attacks|business|view]');
  process.exit(2);
}

const [ana, ben, carla] = await readSeed();
if (!ana || !ben || !carla) {
  console.error('No sample payments: create them first with npm run seed, or New sample payments on /support.');
  process.exit(1);
}
const { ai } = await loadSettings();
if (!ai.baseUrl || !ai.apiKey || !ai.agentModel) {
  console.error('No AI model: choose one on /settings or set LLM_BASE_URL, LLM_API_KEY and AGENT_MODEL.');
  process.exit(1);
}

// An explicit REDTEAM_TESTS must be a whole number of attacks per plugin, never silently ignored.
const tests = process.env.REDTEAM_TESTS;
if (tests !== undefined && !/^[1-9]\d*$/.test(tests)) {
  console.error(`REDTEAM_TESTS must be a whole number of attacks per plugin, like 1 or 3 (got "${tests}").`);
  process.exit(2);
}

const password = process.env.DEMO_PASSWORD;
const fixtures: Fixtures = {
  target: (process.env.REDTEAM_TARGET ?? 'http://localhost:3000').replace(/\/+$/, ''),
  authorization: password ? `Basic ${Buffer.from(`redteam:${password}`).toString('base64')}` : undefined,
  transcript: join(root, 'redteam', 'transcript.mjs'),
  llm: { baseUrl: ai.baseUrl, apiKey: ai.apiKey, model: process.env.REDTEAM_MODEL || ai.judgeModel || ai.agentModel },
  ana,
  ben,
  carla,
  numTests: tests ? Number(tests) : undefined,
  remote: process.env.REDTEAM_REMOTE === '1',
};
// What the guard-held metric compares against (redteam/transcript.mjs).
env.REDTEAM_OWN_CAPTURE = ana.captureId;
env.REDTEAM_OWN_PAID = ana.amount.value;
env.REDTEAM_OTHER_EMAILS = [ben.customerEmail, carla.customerEmail].join(',');

mkdirSync(out, { recursive: true });
const file = join(out, `${mode}.json`);
// The generated config holds the API key, like .env.local: redteam/.generated is git-ignored.
writeFileSync(file, JSON.stringify(mode === 'attacks' ? attackConfig(fixtures) : businessConfig(fixtures), null, 2), { mode: 0o600 });
// writeFile's mode only applies to a new file: an older one keeps its permissions otherwise.
chmodSync(file, 0o600);
console.log(`Testing ${fixtures.target} as ${ana.customerEmail}; attacks written and graded by ${fixtures.llm.model}.`);

process.exit(
  mode === 'attacks'
    ? promptfoo('redteam', 'run', '-c', file, '--output', join(out, 'attacks-tests.yaml'), '-j', '2')
    : promptfoo('eval', '-c', file, '-j', '1', '--no-cache'),
);
