  "guide": {
    "title": "如何使用这个仪表板",
    "intro": "使用 AG Studio 构建。尝试每个步骤时，可以一直开着这份指南。",
    "close": "关闭指南",
    "read": {
      "title": "阅读页面",
      "body": "每个组件回答一个问题，标题会说明是哪个问题。把指针移到柱条或色带上即可查看数字。"
    },
    "filter": {
      "title": "点击即可筛选",
      "click": "点击<b>{flow}</b>中的某个智能体，或图表中的某根柱条，页面上的其他组件就只显示这部分。再点一次即可清除。",
      "panel": "打开右侧边缘的<b>{filters}</b>，查看页面的筛选以及你点击产生的筛选。"
    },
    "pages": {
      "title": "在页面和报表之间切换",
      "menu": "打开的报表的页面列在左侧菜单的<b>{dashboard}</b>下。<b>{addPage}</b>会添加一个空白页面；双击页面或报表即可重命名。",
      "reports": "<b>{newReport}</b>会新建一个空白报表。报表的<b>⋯</b>菜单里有<b>{rename}</b>、<b>{duplicate}</b>和删除。<b>{resetDemo}</b>会恢复内置报表，并移除你创建的报表。"
    },
    "edit": {
      "title": "编辑页面",
      "open": "点击<b>{edit}</b>。右侧会打开两个面板：<b>{compose}</b>和<b>{data}</b>。",
      "add": "<b>添加组件：</b>在<b>{compose}</b>中打开<b>{widgets}</b>，把一个组件拖到页面上。也可以从<b>{data}</b>拖一个字段（智能体、客户、金额）到页面上，Studio 会用它生成图表。",
      "change": "<b>修改组件：</b>点击它。它的设置会显示在<b>{compose}</b>中：图表类型、各坐标轴的字段、排序和标题。",
      "move": "<b>移动或调整大小：</b>拖动组件即可移动，拖动边缘即可调整大小。它的工具栏可以复制或删除它。",
      "save": "撤销和重做在<b>{save}</b>旁边。<b>{save}</b>会把报表保存在此浏览器中；<b>{discard}</b>会丢弃更改；<b>{view}</b>会退出编辑。"
    },
    "guardWidget": {
      "title": "添加守卫专属组件",
      "body": "在<b>{compose}</b> › <b>{widgets}</b>中，<b>{group}</b>分组里有<b>{flow}</b>：每个智能体的调用经过守卫后的去向。把它拖到任意页面即可。"
    },
    "export": {
      "title": "导出",
      "body": "表格或图表的工具栏可以把数据行下载为 CSV，或把图表下载为图片。"
    },
    "ai": {
      "title": "询问 AI",
      "on": "在<b>{edit}</b>模式下打开<b>{assistant}</b>，描述你想要的组件，例如“按客户统计被拦截的退款”。它会在页面上生成该组件，你可以像其他更改一样保留或放弃。",
      "off": "<b>{assistant}</b>可以根据一句话生成组件。在服务器上设置 OpenAI 密钥后，它会出现在编辑模式中（参见 README）。"
    }
  },
