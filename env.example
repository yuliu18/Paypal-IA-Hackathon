# PayPal Sandbox credentials, can be obtained from developer.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# Password for the whole app (HTTP Basic auth, any user name). Required in production, where
# the app refuses every request without it; leave blank for open local development. Use a long
# random value: 10 wrong passwords lock that client out for 15 minutes, but guesses stay possible.
DEMO_PASSWORD=

# OpenAI-compatible LLM for the support agent and the payment guard's intent judge
# (e.g. OpenCode Go: https://opencode.ai/inference/go/openai/v1). JUDGE_MODEL defaults to AGENT_MODEL.
LLM_BASE_URL=
LLM_API_KEY=
AGENT_MODEL=
JUDGE_MODEL=

# Optional: the shop's own contact email(s), comma-separated. The support agent's replies may give
# them out; every other email except the ticket customer's is masked.
SHOP_CONTACT_EMAIL=

# Optional: lets /settings store API keys, encrypted with this value (16+ random characters).
# Changing it makes saved keys unreadable; they then have to be entered again.
SETTINGS_SECRET=

# Optional: true makes /settings read-only and turns off its connection tests (for a public demo).
SETTINGS_LOCKED=

# Optional: the variables above (PayPal, LLM, SHOP_CONTACT_EMAIL) are fallbacks; values saved on
# /settings take precedence.

# Optional: AG Studio licence key for /dashboard.
AG_STUDIO=

# Optional: the AG Studio AI assistant on /dashboard. If blank, an OPENAI_API_KEY already in
# your environment is used instead; with neither, the assistant is hidden.
AG_STUDIO_OPENAI_API_KEY=

# Comma-separated OpenAI model ids for the assistant's model picker; the first is the default.
# If blank, gpt-5.4-mini is used as the default, and no model switcher options are available.
OPENAI_MODELS=gpt-5.6-terra,gpt-5.6-luna,gpt-5.6-sol
