# Only what the server needs before anyone can sign in. Everything else (PayPal apps, AI provider
# and models, business, limits, notifications, API keys) is set on /settings and saved, encrypted,
# in the database. Copy this file to .env.local locally, or set the same names on your host.

# --- Database (any Postgres) --------------------------------------------------------------------
# Neon, Supabase, your own server, or locally `docker compose up -d` (docker-compose.yml). Holds the
# settings and the guard's audit log. Without it, a local SQLite file and data/settings.json are
# used (fine for development, lost on hosts with no persistent disk such as Render's free plan).
# With Neon, `neon init` + `neon deploy` write both; elsewhere DATABASE_URL_UNPOOLED is optional.
# A provider with its own certificate authority (Supabase, RDS): add &sslrootcert=/path/ca.pem.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Owner login ---------------------------------------------------------------------------------
# By default the app keeps the owner's account itself: in DATABASE_URL's `auth` schema, or without a
# database in a SQLite file, AUTH_DB (optional, default data/auth.db). Forgot the password: run
# `npm run owner:reset` on the server.
AUTH_DB=

# Optional instead: Neon Auth (adds recovery by emailed code). Set both; Neon Auth keeps the owner in
# the Neon database, so DATABASE_URL must then be that Neon project's. NEON_AUTH_BASE_URL comes from
# `neon deploy`; NEON_AUTH_COOKIE_SECRET is 32+ random characters (`openssl rand -base64 32`).
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# --- Settings ----------------------------------------------------------------------------------
# Encrypts the keys saved on /settings (16+ random characters). Best set on the host, so the key
# is not stored next to the data. If blank, one is generated and stored with the settings.
SETTINGS_SECRET=

# true makes /settings read-only and turns off its connection tests (for a public demo).
SETTINGS_LOCKED=

# --- Live mode (real money) --------------------------------------------------------------------
# true lets the owner turn on live mode in Settings › PayPal app. Leave blank on a public demo.
ALLOW_LIVE_MODE=

# The app's public URL (e.g. https://your-app.onrender.com): where buyers return after paying,
# the links in held-action notifications, and the server named in the API docs.
APP_URL=

# --- Optional: the AG Studio dashboard ----------------------------------------------------------
# AG Studio licence key for /dashboard.
AG_STUDIO=
# OpenAI key for the dashboard's AI assistant (falls back to OPENAI_API_KEY; with neither, hidden).
AG_STUDIO_OPENAI_API_KEY=
# Comma-separated OpenAI model ids for the assistant's picker; the first is the default.
OPENAI_MODELS=
