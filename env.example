# PayPal Sandbox credentials, can be obtained from developer.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# Password for the whole app (HTTP Basic auth, any user name). Required in production, where
# the app refuses every request without it; leave blank for open local development. Use a long
# random value: 10 wrong passwords lock that client out for 15 minutes, but guesses stay possible.
DEMO_PASSWORD=

# Optional: the OpenAI-compatible AI provider and key for the support agent and the guard's judge
# (e.g. OpenCode Go: https://opencode.ai/inference/go/openai/v1), used until /settings saves one.
# The models are chosen on /settings; until then, the provider's newest model that can call tools.
LLM_BASE_URL=
LLM_API_KEY=

# Optional: the shop's own contact email(s), comma-separated. The support agent's replies may give
# them out; every other email except the ticket customer's is masked.
SHOP_CONTACT_EMAIL=

# Optional: encrypts the API keys saved on /settings (16+ random characters). If blank, a random
# key is generated in data/settings.key. Changing it makes saved keys unreadable; enter them again.
SETTINGS_SECRET=

# Optional: true makes /settings read-only and turns off its connection tests (for a public demo).
SETTINGS_LOCKED=

# Optional: tell a person when the guard holds a refund for approval. Each channel left blank is off.
# A Slack or Discord incoming webhook URL.
GUARD_WEBHOOK_URL=
# Email, sent to SHOP_CONTACT_EMAIL from NOTIFY_EMAIL_FROM, through SMTP when SMTP_HOST, SMTP_USER and SMTP_PASSWORD are set, else Resend.
# SMTP: e.g. smtp.gmail.com with port 587 (STARTTLS) or 465 (TLS), your address and an app password.
# NOTIFY_EMAIL_FROM may stay blank with SMTP: the login is the sender.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# Resend: its test sender onboarding@resend.dev only delivers to the Resend account owner's address.
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=
# Telegram: the bot's token and the chat to post in (see README for getting the chat id).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# The app's public URL, so the message links to /guard instead of naming the path.
APP_URL=

# Optional: the variables above (PayPal, LLM, SHOP_CONTACT_EMAIL, notifications) are fallbacks;
# values saved on /settings take precedence.

# Optional: AG Studio licence key for /dashboard.
AG_STUDIO=

# Optional: the AG Studio AI assistant on /dashboard. If blank, an OPENAI_API_KEY already in
# your environment is used instead; with neither, the assistant is hidden.
AG_STUDIO_OPENAI_API_KEY=

# Comma-separated OpenAI model ids for the assistant's model picker; the first is the default.
# If blank, gpt-5.4-mini is used as the default, and no model switcher options are available.
OPENAI_MODELS=gpt-5.6-terra,gpt-5.6-luna,gpt-5.6-sol
